{
  "permissions": {
    "allow": [
      "Bash(flutter analyze:*)",
      "Bash(flutter test:*)",
      "Bash(flutter pub get)",
      "Bash(dart format:*)",
      "Bash(dart run build_runner build:*)",
      "Bash(dart run slang:*)",
      "Bash(python3 tools/ds_guard.py:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch --show-current)",
      "Bash(git branch --list:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr list:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git push -f:*)",
      "Bash(git branch -D:*)",
      "Bash(git branch -f:*)",
      "Bash(flutter build:*)",
      "Read(./env/*.env)",
      "Read(./android/key.properties)",
      "Read(./android/app/*.jks)",
      "Read(./ios/Runner/GoogleService-Info.plist)",
      "Read(./android/app/google-services.json)"
    ]
  }
}
